{
  "id": "lab.mini_ospf_passive",
  "title": "OSPF passive interface",
  "hidden": true,
  "domain": "d3",
  "subtopics": [
    "3.4"
  ],
  "description": "Exam-style simulation item.",
  "topology": "  [R1] Gi0/0 10.0.0.1/30 ── 10.0.0.2 [R2]\n  [R1] Gi0/1 192.168.1.1/24 ── SW1 ── user LAN\n  Both R1 interfaces are in OSPF process 1, area 0.",
  "devices": [
    {
      "name": "R1",
      "type": "router",
      "editable": true,
      "interfaces": [
        {
          "name": "g0/0"
        },
        {
          "name": "g0/1"
        }
      ],
      "config": [
        "interface g0/0",
        "ip address 10.0.0.1 255.255.255.252",
        "no shutdown",
        "interface g0/1",
        "ip address 192.168.1.1 255.255.255.0",
        "no shutdown",
        "router ospf 1",
        "network 10.0.0.0 0.0.0.3 area 0",
        "network 192.168.1.0 0.0.0.255 area 0"
      ]
    },
    {
      "name": "R2",
      "type": "router",
      "editable": false,
      "interfaces": [
        {
          "name": "g0/0"
        }
      ],
      "config": [
        "interface g0/0",
        "ip address 10.0.0.2 255.255.255.252",
        "no shutdown",
        "router ospf 1",
        "network 10.0.0.0 0.0.0.3 area 0"
      ]
    },
    {
      "name": "SW1",
      "type": "switch",
      "editable": false,
      "interfaces": [
        {
          "name": "g0/1"
        },
        {
          "name": "g0/2"
        }
      ],
      "config": []
    }
  ],
  "links": [
    [
      "R1",
      "g0/0",
      "R2",
      "g0/0"
    ],
    [
      "R1",
      "g0/1",
      "SW1",
      "g0/1"
    ]
  ],
  "tasks": [
    {
      "text": "Stop R1 sending OSPF Hellos on its user LAN (Gi0/1), but keep advertising 192.168.1.0/24 and keep the adjacency with R2.",
      "checks": [
        {
          "device": "R1",
          "check": "ospf_passive",
          "args": {
            "iface": "g0/1"
          }
        },
        {
          "device": "R1",
          "check": "ospf_neighbor",
          "args": {
            "neighbor": "R2"
          }
        },
        {
          "device": "R2",
          "check": "route_to",
          "args": {
            "dest": "192.168.1.10",
            "code": "O"
          }
        }
      ]
    }
  ],
  "solution": {
    "R1": [
      "router ospf 1",
      "passive-interface g0/1",
      "end"
    ]
  }
}
