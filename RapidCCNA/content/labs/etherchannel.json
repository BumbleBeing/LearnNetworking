  "links": [
    [
      "SW1",
      "g0/1",
      "SW2",
      "g0/1"
    ],
    [
      "SW1",
      "g0/2",
      "SW2",
      "g0/2"
    ]
  ],
  "tasks": [
    {
      "text": "Put Gi0/1 and Gi0/2 in channel group 1 so they bundle with SW2 using LACP.",
      "hint": "SW2 is passive, so SW1 must be active: interface range g0/1 - 2 → channel-group 1 mode active",
      "checks": [
        {
          "device": "SW1",
          "check": "etherchannel",
          "args": {
            "group": 1,
            "protocol": "LACP",
            "members": 2
          }
        }
      ]
    },
    {
      "text": "Make Port-channel 1 a static trunk with native VLAN 99, matching SW2.",
      "hint": "interface port-channel 1 → switchport mode trunk → switchport trunk native vlan 99 (members follow the port-channel)",
      "checks": [
        {
          "device": "SW1",
          "check": "trunk_port",
          "args": {
            "iface": "po1",
            "native": 99
          }
        },
        {
          "device": "SW1",
          "check": "etherchannel",
          "args": {
            "group": 1,
            "members": 2
          }
        }
      ]
    },
    {
      "text": "Allow only VLANs 10, 20 and 99 on the trunk.",
      "hint": "interface port-channel 1 → switchport trunk allowed vlan 10,20,99",
      "checks": [
        {
          "device": "SW1",
          "check": "trunk_port",
          "args": {
            "iface": "po1",
            "allowed": "10,20,99"
          }
        },
        {
          "device": "SW1",
          "check": "etherchannel",
          "args": {
            "group": 1,
            "members": 2
          }
        }
      ]
    }
  ],
  "solution": {
    "SW1": [
      "interface range g0/1 - 2",
      "channel-group 1 mode active",
      "exit",
      "interface port-channel 1",
      "switchport mode trunk",
      "switchport trunk native vlan 99",
      "switchport trunk allowed vlan 10,20,99",
      "end"
    ]
  }
}
