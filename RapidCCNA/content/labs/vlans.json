  ],
  "links": [],
  "tasks": [
    {
      "text": "Create VLAN 10 named SALES and VLAN 20 named ENGINEERING.",
      "hint": "vlan 10 → name SALES, then the same for VLAN 20.",
      "checks": [
        {
          "device": "SW1",
          "check": "vlan_exists",
          "args": {
            "id": 10,
            "name": "SALES"
          }
        },
        {
          "device": "SW1",
          "check": "vlan_exists",
          "args": {
            "id": 20,
            "name": "ENGINEERING"
          }
        }
      ]
    },
    {
      "text": "Make Fa0/1 - 5 static access ports in VLAN 10.",
      "hint": "interface range fa0/1 - 5 → switchport mode access → switchport access vlan 10",
      "checks": [
        {
          "device": "SW1",
          "check": "access_port",
          "args": {
            "iface": "fa0/1 - 5",
            "vlan": 10
          }
        }
      ]
    },
    {
      "text": "Make Fa0/6 - 10 static access ports in VLAN 20.",
      "hint": "Same as before with interface range fa0/6 - 10 and VLAN 20.",
      "checks": [
        {
          "device": "SW1",
          "check": "access_port",
          "args": {
            "iface": "fa0/6 - 10",
            "vlan": 20
          }
        }
      ]
    },
    {
      "text": "Create VLAN 99 named NATIVE. Make Gi0/1 a static trunk with native VLAN 99 that allows only VLANs 10, 20 and 99.",
      "hint": "switchport mode trunk, switchport trunk native vlan 99, switchport trunk allowed vlan 10,20,99",
      "checks": [
        {
          "device": "SW1",
          "check": "vlan_exists",
          "args": {
            "id": 99,
            "name": "NATIVE"
          }
        },
        {
          "device": "SW1",
          "check": "trunk_port",
          "args": {
            "iface": "g0/1",
            "native": 99,
            "allowed": "10,20,99"
          }
        }
      ]
    },
    {
      "text": "Administratively shut down the unused ports Fa0/11 - 24.",
      "hint": "interface range fa0/11 - 24 → shutdown",
      "checks": [
        {
          "device": "SW1",
          "check": "iface_shutdown",
          "args": {
            "iface": "fa0/11 - 24"
          }
        }
      ]
    }
  ],
  "solution": {
    "SW1": [
      "vlan 10",
      "name SALES",
      "vlan 20",
      "name ENGINEERING",
      "vlan 99",
      "name NATIVE",
      "interface range fa0/1 - 5",
      "switchport mode access",
      "switchport access vlan 10",
      "interface range fa0/6 - 10",
      "switchport mode access",
      "switchport access vlan 20",
      "interface g0/1",
      "switchport mode trunk",
      "switchport trunk native vlan 99",
      "switchport trunk allowed vlan 10,20,99",
      "interface range fa0/11 - 24",
      "shutdown",
      "end"
    ]
  }
}
