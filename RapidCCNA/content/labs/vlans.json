{
  "id": "lab.vlans",
  "title": "VLANs and trunks",
  "domain": "d2",
  "unit": "d2.vlans_trunks",
  "subtopics": [
    "2.1",
    "2.2"
  ],
  "description": "Split SW1 into Sales and Engineering VLANs and set up a locked-down trunk to SW2.",
  "topology": "               [SW2]\n                 │ Gi0/1 (trunk)\n               [SW1]\n      ┌──────────┴──────────┐\n  Fa0/1 - 5            Fa0/6 - 10\n  Sales PCs            Engineering PCs\n\n  Fa0/11 - 24: unused",
  "devices": [
    {
      "name": "SW1",
      "type": "switch",
      "editable": true,
      "interfaces": [
        {
          "name": "fa0/1"
        },
        {
          "name": "fa0/2"
        },
