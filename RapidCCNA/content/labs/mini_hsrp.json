          "name": "g0/1"
        },
        {
          "name": "g0/2"
        }
      ]
    }
  ],
  "links": [
    [
      "R1",
      "g0/0",
      "SW1",
      "g0/1"
    ],
    [
      "R2",
      "g0/0",
      "SW1",
      "g0/2"
    ]
  ],
  "tasks": [
    {
      "text": "Configure R1 in HSRP group 5 (virtual IP 10.5.5.1) so that it becomes the active router.",
      "checks": [
        {
          "device": "R1",
          "check": "hsrp",
          "args": {
            "iface": "g0/0",
            "group": 5,
            "vip": "10.5.5.1",
            "state": "Active"
          }
        }
      ]
    }
  ],
  "solution": {
    "R1": [
      "interface g0/0",
      "standby 5 ip 10.5.5.1",
      "standby 5 priority 150",
      "standby 5 preempt",
      "end"
    ]
  }
