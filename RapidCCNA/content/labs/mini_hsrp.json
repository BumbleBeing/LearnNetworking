      ],
      "config": [
        "interface g0/0",
        "ip address 10.5.5.3 255.255.255.0",
        "standby 5 ip 10.5.5.1",
        "no shutdown"
      ]
    },
    {
      "name": "SW1",
      "type": "switch",
      "editable": false,
