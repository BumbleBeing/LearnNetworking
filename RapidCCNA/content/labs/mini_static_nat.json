{
  "id": "lab.mini_static_nat",
  "title": "Static NAT",
  "hidden": true,
  "domain": "d4",
  "subtopics": [
    "4.1"
  ],
  "description": "Exam-style simulation item.",
  "topology": "  Web server 192.168.1.20 ── Gi0/0 [R1] Gi0/1 203.0.113.2/29 ── ISP\n  Public address for the server: 203.0.113.4",
  "devices": [
    {
      "name": "R1",
      "type": "router",
      "editable": true,
      "interfaces": [
        {
          "name": "g0/0"
        },
        {
          "name": "g0/1"
        }
      ],
      "config": [
        "interface g0/0",
        "ip address 192.168.1.1 255.255.255.0",
        "no shutdown",
        "interface g0/1",
        "ip address 203.0.113.2 255.255.255.248",
        "no shutdown",
        "ip route 0.0.0.0 0.0.0.0 203.0.113.1"
      ]
    }
  ],
  "links": [],
  "tasks": [
    {
      "text": "Make the web server 192.168.1.20 reachable from the internet as 203.0.113.4. Gi0/0 faces the LAN and Gi0/1 the ISP.",
      "checks": [
        {
          "device": "R1",
          "check": "nat_iface",
          "args": {
            "iface": "g0/0",
            "side": "inside"
          }
        },
        {
          "device": "R1",
          "check": "nat_iface",
          "args": {
            "iface": "g0/1",
            "side": "outside"
          }
        },
        {
          "device": "R1",
          "check": "nat_translates",
          "args": {
            "inside": "192.168.1.20",
            "global": "203.0.113.4"
          }
        }
      ]
    }
  ],
  "solution": {
    "R1": [
      "interface g0/0",
      "ip nat inside",
      "interface g0/1",
      "ip nat outside",
      "exit",
      "ip nat inside source static 192.168.1.20 203.0.113.4",
      "end"
    ]
  }
}
