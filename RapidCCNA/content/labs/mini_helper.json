  "tasks": [
    {
      "text": "Make R1 forward the PC's DHCP requests to the server at 10.0.0.10.",
      "checks": [
        {
          "device": "PC",
          "check": "dhcp_lease",
          "args": {
            "subnet": "192.168.30.0/24",
            "gateway": "192.168.30.1"
          }
        }
      ]
    }
  ],
  "solution": {
    "R1": [
      "interface g0/1",
      "ip helper-address 10.0.0.10",
      "end"
