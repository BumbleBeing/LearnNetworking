  "tasks": [
    {
      "text": "Find the port that connects to router R1 and set its description to 'Uplink to R1'.",
      "hint": "show cdp neighbors: 'Local Intrfce' is SW1's port. Then interface <that port> → description Uplink to R1",
      "checks": [
        {
          "device": "SW1",
          "check": "iface_description",
          "args": {
            "iface": "g0/2",
            "contains": "R1"
          }
        }
      ]
    },
    {
      "text": "The lobby access point isn't a Cisco device, so CDP can't see it. Turn on LLDP, find the AP's port and describe it as 'AP-LOBBY'.",
      "hint": "lldp run, then do show lldp neighbors. Look for capability W.",
      "checks": [
        {
          "device": "SW1",
          "check": "lldp_run",
          "args": {
            "enabled": true
          }
        },
        {
          "device": "SW1",
          "check": "discovers",
          "args": {
            "neighbor": "AP-LOBBY",
            "protocol": "lldp"
          }
        },
        {
          "device": "SW1",
          "check": "iface_description",
          "args": {
            "iface": "fa0/7",
            "contains": "AP-LOBBY"
          }
        }
      ]
    },
    {
      "text": "Fa0/24 faces a public kiosk. Stop SW1 sending CDP and LLDP out of that port, while both protocols keep running everywhere else.",
      "hint": "interface fa0/24 → no cdp enable → no lldp transmit (don't use 'no cdp run': that turns CDP off everywhere)",
      "checks": [
        {
          "device": "SW1",
          "check": "cdp_iface",
          "args": {
            "iface": "fa0/24",
            "enabled": false
          }
        },
        {
          "device": "SW1",
          "check": "lldp_iface",
          "args": {
            "iface": "fa0/24",
            "transmit": false
          }
        },
        {
          "device": "SW1",
          "check": "cdp_run",
          "args": {
            "enabled": true
          }
        },
        {
          "device": "SW1",
          "check": "lldp_run",
          "args": {
            "enabled": true
          }
        },
        {
          "device": "SW1",
          "check": "discovers",
          "args": {
            "neighbor": "R1",
            "protocol": "cdp"
          }
        }
      ]
    }
  ],
  "solution": {
    "SW1": [
      "interface g0/2",
      "description Uplink to R1",
      "exit",
      "lldp run",
      "interface fa0/7",
      "description AP-LOBBY",
      "interface fa0/24",
      "no cdp enable",
      "no lldp transmit",
      "end"
    ]
  }
}
